# Copy this file to .env and fill in your values.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which Claude model to use for answering questions.
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdocs

# Local embedding model (sentence-transformers). 384-dim output must match
# the `vector(384)` column in sql/init.sql if you change this.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Sliding-window chunking parameters (characters).
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# How many chunks to retrieve per question.
TOP_K=4
